---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories } from '../../../data/runbooks';
import { SITE_URL, schemaWebSite } from '../../../data/site';
import type { Category, RunbookService } from '../../../data/runbooks';

export function getStaticPaths() {
  return categories.flatMap((category) =>
    category.services.map((service) => ({
      params: { category: category.slug, service: service.slug },
      props: { category, service },
    }))
  );
}

interface Props {
  category: Category;
  service: RunbookService;
}

const { category, service } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const severityColors: Record<string, string> = {
  critical: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
  warning: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
  info: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: `${service.service} Runbooks`,
  description: service.description,
  url: `${SITE_URL}runbooks/${category.slug}/${service.slug}/`,
  isPartOf: schemaWebSite,
};
---

<BaseLayout
  title={`${service.service} Runbooks — ${category.name} | SRE Alerts & Runbooks`}
  description={service.description}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { label: 'Runbooks', href: `${base}/runbooks/` },
        { label: category.name, href: `${base}/runbooks/` },
        { label: service.service },
      ]}
      base={base}
    />

    <div class="mt-6 mb-8">
      <p class="text-xs font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">{category.name}</p>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{service.service}</h1>
      <p class="text-slate-500 dark:text-slate-400 mt-2">{service.description}</p>
    </div>

    <div class="rounded-xl border border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800">
        <h2 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Alert runbooks ({service.alerts.length})</h2>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        {service.alerts.map((alert) => (
          <a
            href={`${base}/runbooks/${category.slug}/${service.slug}/${alert.slug}/`}
            class="flex items-start gap-4 px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group"
          >
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full flex-shrink-0 ${severityColors[alert.severity] ?? severityColors.info}`}>
                  {alert.severity}
                </span>
                <span class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-brand dark:group-hover:text-brand-dark truncate">
                  {alert.name}
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2">{alert.overview?.what ?? ''}</p>
            </div>
            <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-hover:text-brand dark:group-hover:text-brand-dark mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>

    {category.services.length > 1 && (
      <div class="mt-8">
        <h2 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">More {category.name} runbooks</h2>
        <div class="flex flex-wrap gap-2">
          {category.services.filter((s) => s.slug !== service.slug).map((s) => (
            <a
              href={`${base}/runbooks/${category.slug}/${s.slug}/`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-brand/50 hover:text-brand dark:hover:text-brand-dark transition-colors"
            >
              {s.service}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
