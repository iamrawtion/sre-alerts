---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { data, getTotalRunbookCount } from '../../data/runbooks';
import { SITE_URL, schemaWebSite } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalRunbooks = getTotalRunbookCount();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'SRE Runbooks & Troubleshooting Guides',
  description: 'Per-service runbooks linked to Prometheus alerting rules — what each alert means, how to investigate, and step-by-step resolution procedures.',
  url: `${SITE_URL}runbooks/`,
  isPartOf: schemaWebSite,
};
---

<BaseLayout
  title="Runbooks & Troubleshooting Guides | SRE Alerts & Runbooks"
  description={`${totalRunbooks} per-service runbooks linked to alerting rules — what each alert means, how to investigate, and step-by-step resolution procedures.`}
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: 'Runbooks' }]} base={base} />

    <!-- Header -->
    <div class="mt-6 mb-8">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Runbooks &amp; Troubleshooting Guides</h1>
      <p class="text-slate-500 dark:text-slate-400">
        Per-service runbooks linked to alerting rules — what the alert means, how to investigate it,
        and step-by-step resolution procedures for each service.
      </p>
    </div>

    <!-- Category cards -->
    <div class="space-y-6">
      {data.categories.map((category) => (
        <section class="rounded-xl border border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 overflow-hidden">
          <!-- Category header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 dark:border-slate-800">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-white">{category.name}</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{category.description}</p>
            </div>
            <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-brand/10 dark:bg-brand-dark/10 text-brand dark:text-brand-dark flex-shrink-0">
              {category.runbooks.length} runbooks
            </span>
          </div>
          <!-- Runbook list -->
          <div class="px-6 py-4">
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
              {category.runbooks.map((runbook) => (
                <a
                  href={`${base}/runbooks/${category.slug}/${runbook.slug}/`}
                  class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-brand/50 dark:hover:border-brand-dark/50 hover:text-brand dark:hover:text-brand-dark transition-colors group"
                >
                  <svg class="w-3.5 h-3.5 flex-shrink-0 text-slate-400 group-hover:text-brand dark:group-hover:text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                  <span class="text-xs font-medium">{runbook.title}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
