---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTotalRuleCount, getTotalServiceCount } from '../../data/rules';
import { SITE_URL, schemaWebSite } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalRules = getTotalRuleCount();
const totalServices = getTotalServiceCount();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Prometheus Monitoring — Rules, Configs & Runbooks',
  description: `${totalRules} production-ready Prometheus alerting rules for ${totalServices} services, plus platform configs and per-service runbooks.`,
  url: `${SITE_URL}prometheus/`,
  isPartOf: schemaWebSite,
};

const sections = [
  {
    title: 'Alert Rules',
    href: `${base}/rules/`,
    status: 'live' as const,
    icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
    description: 'Copy-pasteable Prometheus alerting rules for databases, Kubernetes, cloud providers, and more.',
    meta: `${totalRules} rules · ${totalServices} services · 13 categories`,
  },
  {
    title: 'Platform Configs',
    href: `${base}/configs/`,
    status: 'planned' as const,
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
    description: 'Scrape configs, recording rules, remote write, Thanos sidecar, and VictoriaMetrics setup.',
    meta: 'Coming soon',
  },
  {
    title: 'Runbooks',
    href: `${base}/runbooks/`,
    status: 'planned' as const,
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    description: 'Per-service runbooks linked to alerting rules — what the alert means and step-by-step resolution.',
    meta: 'Coming soon',
  },
];
---

<BaseLayout
  title="Prometheus Monitoring — Rules, Configs & Runbooks | SRE Alerts"
  description={`${totalRules} production-ready Prometheus alerting rules for ${totalServices} services, plus platform configs and per-service runbooks.`}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: 'Prometheus' }]} base={base} />

    <!-- Header -->
    <div class="mt-6 mb-8 flex items-center gap-3">
      <img src="https://cdn.simpleicons.org/prometheus" alt="Prometheus" class="w-10 h-10 flex-shrink-0" />
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Prometheus</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Production-ready alerting rules, platform configs, and runbooks.</p>
      </div>
    </div>

    <!-- Section cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {sections.map((section) => (
        <a
          href={section.href}
          class={`group block p-5 rounded-xl border transition-all ${
            section.status === 'live'
              ? 'border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 hover:border-brand/40 dark:hover:border-brand-dark/40 hover:shadow-sm'
              : 'border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-600'
          }`}
        >
          <div class={`mb-3 ${section.status === 'live' ? 'text-brand dark:text-brand-dark' : 'text-slate-400 dark:text-slate-500'}`}>
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={section.icon} />
            </svg>
          </div>
          <h2 class={`font-semibold mb-1 transition-colors ${
            section.status === 'live'
              ? 'text-slate-800 dark:text-slate-100 group-hover:text-brand dark:group-hover:text-brand-dark'
              : 'text-slate-500 dark:text-slate-400'
          }`}>{section.title}</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{section.description}</p>
          <p class={`text-xs font-medium ${section.status === 'live' ? 'text-brand dark:text-brand-dark' : 'text-amber-600 dark:text-amber-400'}`}>
            {section.meta}
          </p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
