---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tools } from '../../data/tools';
import type { Tool } from '../../data/tools';
import { SITE_URL, schemaWebSite } from '../../data/site';

export function getStaticPaths() {
  return tools
    .filter((t) => t.status === 'planned')
    .map((tool) => ({
      params: { tool: tool.slug },
      props: { tool },
    }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${tool.name} Monitoring — Coming Soon | SRE Alerts`,
  url: `${SITE_URL}${tool.slug}/`,
  isPartOf: schemaWebSite,
};
---

<BaseLayout
  title={`${tool.name} Monitoring — Coming Soon | SRE Alerts & Runbooks`}
  description={`${tool.name} alerting rules, configs, and runbooks are coming to SRE Alerts & Runbooks. Check back soon or contribute on GitHub.`}
  jsonLd={jsonLd}
  noIndex={true}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: tool.name }]} base={base} />

    <!-- Header -->
    <div class="mt-6 mb-6 flex items-center gap-3">
      {tool.logo
        ? <img src={tool.logo} alt={tool.name} class="w-10 h-10 flex-shrink-0 opacity-70" />
        : <span class="text-3xl" aria-hidden="true">{tool.emoji}</span>
      }
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{tool.name}</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Monitoring rules, configs &amp; runbooks</p>
      </div>
    </div>

    <!-- Coming soon banner -->
    <div class="mb-8 rounded-lg border border-amber-200 dark:border-amber-800/50 bg-amber-50 dark:bg-amber-900/20 px-4 py-3 flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm text-amber-800 dark:text-amber-200">
        {tool.name} content is being written. Check back soon or{' '}
        <a href="https://github.com/iamrawtion/sre-alerts" class="underline font-medium" target="_blank" rel="noopener noreferrer">
          contribute on GitHub
        </a>.
      </p>
    </div>

    <!-- What's planned -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 p-6">
      <h2 class="text-base font-semibold text-slate-900 dark:text-white mb-4">What's planned</h2>
      <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Alerting rules and monitor definitions
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Platform configuration examples
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Per-service runbooks with step-by-step resolution
        </li>
      </ul>
    </div>

    <div class="mt-6 text-center">
      <a href={`${base}/`} class="text-sm text-slate-500 dark:text-slate-400 hover:text-brand dark:hover:text-brand-dark transition-colors">
        ← Back to all tools
      </a>
    </div>
  </div>
</BaseLayout>
