---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { data, getTotalConfigCount } from '../../data/configs';
import { SITE_URL, schemaWebSite } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalConfigs = getTotalConfigCount();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Monitoring Platform Configs',
  description: 'Reference configuration files for Prometheus, Thanos, and VictoriaMetrics.',
  url: `${SITE_URL}configs/`,
  isPartOf: schemaWebSite,
};
---

<BaseLayout
  title="Monitoring Platform Configs | SRE Alerts & Runbooks"
  description={`${totalConfigs} reference configuration files for Prometheus, Thanos, and VictoriaMetrics — scrape configs, recording rules, remote write, and more.`}
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: 'Configs' }]} base={base} />

    <!-- Header -->
    <div class="mt-6 mb-8">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Monitoring Platform Configs</h1>
      <p class="text-slate-500 dark:text-slate-400">
        Reference configuration files for deploying and tuning your monitoring stack.
        Copy-pasteable configs with comments explaining non-obvious settings.
      </p>
    </div>

    <!-- Platform sections -->
    <div class="space-y-6">
      {data.platforms.map((platform) => (
        <section class="rounded-xl border border-slate-200 dark:border-slate-700/60 bg-white dark:bg-slate-900 overflow-hidden">
          <!-- Platform header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 dark:border-slate-800">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-white">{platform.name}</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{platform.description}</p>
            </div>
            <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-brand/10 dark:bg-brand-dark/10 text-brand dark:text-brand-dark flex-shrink-0">
              {platform.configs.length} configs
            </span>
          </div>
          <!-- Config file list -->
          <div class="px-6 py-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2">
              {platform.configs.map((config) => (
                <a
                  href={`${base}/configs/${platform.slug}/${config.slug}/`}
                  class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-brand/50 dark:hover:border-brand-dark/50 hover:text-brand dark:hover:text-brand-dark transition-colors group"
                >
                  <svg class="w-3.5 h-3.5 flex-shrink-0 text-slate-400 group-hover:text-brand dark:group-hover:text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <span class="text-xs font-medium truncate">{config.title}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
