---
import type { Tool } from '../data/tools';
import { tools } from '../data/tools';

interface Props {
  activeTool: Tool;
  base: string;
}

const { activeTool, base } = Astro.props;
---

<div class="relative group hidden md:block">
  <button
    type="button"
    class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold text-brand dark:text-brand-dark border border-brand/30 dark:border-brand-dark/30 hover:bg-brand/5 dark:hover:bg-brand-dark/5 transition-colors"
    aria-haspopup="true"
  >
    {activeTool.logo
      ? <img src={activeTool.logo} alt="" class="w-4 h-4" aria-hidden="true" />
      : <span aria-hidden="true">{activeTool.emoji}</span>
    }
    {activeTool.name}
    <svg class="w-3.5 h-3.5 text-brand/60 dark:text-brand-dark/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown -->
  <div class="absolute top-full left-0 mt-1 w-52 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 py-1 z-50">
    <p class="px-3 pt-1.5 pb-1 text-xs font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500">Switch tool</p>
    {tools.map((tool) => (
      tool.status === 'live'
        ? (
          <a
            href={`${base}${tool.paths.hub}`}
            class={`flex items-center gap-2.5 px-3 py-2 text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors ${tool.slug === activeTool.slug ? 'text-brand dark:text-brand-dark font-medium' : 'text-slate-700 dark:text-slate-200'}`}
          >
            {tool.logo
              ? <img src={tool.logo} alt="" class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
              : <span class="w-4 text-center text-xs" aria-hidden="true">{tool.emoji}</span>
            }
            {tool.name}
          </a>
        )
        : (
          <div class="flex items-center justify-between gap-2 px-3 py-2 text-sm text-slate-400 dark:text-slate-500 cursor-default">
            <span class="flex items-center gap-2.5">
              {tool.logo
                ? <img src={tool.logo} alt="" class="w-4 h-4 flex-shrink-0 opacity-40" aria-hidden="true" />
                : <span class="w-4 text-center text-xs opacity-60" aria-hidden="true">{tool.emoji}</span>
              }
              {tool.name}
            </span>
            <span class="text-xs px-1.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-medium">soon</span>
          </div>
        )
    ))}
  </div>
</div>
